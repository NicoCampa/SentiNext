# === REQUIRED ===
# Database connection (for Docker Compose this is overridden; for local dev use localhost)
DATABASE_URL=postgresql://sentinext:sentinext@localhost:5432/sentinext

# At least one LLM API key (pick one):
GEMINI_API_KEY=your_gemini_key_here
# XAI_API_KEY=your_xai_key_here
# OPENAI_API_KEY=your_openai_key_here

# === LLM PROVIDER OPTIONS ===
# Set the active provider/model (must be configured via Settings page or here)
# SENTINEXT_LLM_PROVIDER=gemini
# SENTINEXT_LLM_MODEL=gemini-flash-lite-latest

# Gemini models
# SENTINEXT_GEMINI_MODEL=gemini-flash-lite-latest
# SENTINEXT_GEMINI_MODEL_CHEAP=gemini-flash-lite-latest

# xAI (Grok) models
# SENTINEXT_XAI_MODEL=grok-4-1-fast-non-reasoning

# OpenAI models
# SENTINEXT_OPENAI_MODEL=gpt-5-mini

# Ollama (local models, no API key needed)
# Auto-detects Docker and uses host.docker.internal; override if needed:
# SENTINEXT_OLLAMA_BASE_URL=http://localhost:11434/v1
# SENTINEXT_OLLAMA_MODEL=llama3.1:8b

# === SECURITY ===
# Protect destructive operations (database clear, game delete) with a token
# SENTINEXT_ADMIN_TOKEN=your_secret_token_here
# Enable destructive database operations (disabled by default, must opt-in)
# SENTINEXT_ENABLE_DESTRUCTIVE=true

# === OPTIONAL ===
# Allowed frontend origins (comma-separated)
# SENTINEXT_ALLOWED_ORIGINS=http://localhost:3000

# Redis (optional, for job queuing and rate limiting)
# REDIS_URL=redis://localhost:6379

# Sentry error monitoring (optional)
# SENTRY_DSN=
