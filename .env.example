# === REQUIRED ===
# Database connection
DATABASE_URL=postgresql://sentinext:sentinext@localhost:5432/sentinext

# At least one LLM API key (pick one):
GEMINI_API_KEY=your_gemini_key_here
# XAI_API_KEY=your_xai_key_here
# OPENAI_API_KEY=your_openai_key_here

# === LLM PROVIDER OPTIONS ===
# Override the active provider/model (auto-detected from API keys by default)
# Priority: xai > gemini > openai > ollama
# SENTINEXT_LLM_PROVIDER=gemini
# SENTINEXT_LLM_MODEL=gemini-2.0-flash-lite

# Gemini models
# SENTINEXT_GEMINI_MODEL=gemini-flash-lite-latest
# SENTINEXT_GEMINI_MODEL_CHEAP=gemini-flash-lite-latest

# xAI (Grok) models
# SENTINEXT_XAI_MODEL=grok-3-fast
# SENTINEXT_XAI_MODEL_REASONING=grok-3

# OpenAI models
# SENTINEXT_OPENAI_MODEL=gpt-4o-mini

# Ollama (local models, no API key needed)
# SENTINEXT_OLLAMA_BASE_URL=http://localhost:11434/v1
# SENTINEXT_OLLAMA_MODEL=llama3.1:8b

# === OPTIONAL ===
# Allowed frontend origins (comma-separated)
# SENTINEXT_ALLOWED_ORIGINS=http://localhost:3000

# Redis (optional, for job queuing and rate limiting)
# REDIS_URL=redis://localhost:6379

# Sentry error monitoring (optional)
# SENTRY_DSN=
