# === REQUIRED ===
# Database connection
DATABASE_URL=postgresql://sentinext:sentinext@localhost:5432/sentinext

# At least one LLM API key (pick one or both):
GEMINI_API_KEY=your_gemini_key_here
# XAI_API_KEY=your_xai_key_here

# === OPTIONAL ===
# LLM model (defaults to gemini-flash-lite-latest)
# SENTINEXT_GEMINI_MODEL=gemini-flash-lite-latest

# Allowed frontend origins (comma-separated)
# SENTINEXT_ALLOWED_ORIGINS=http://localhost:3000

# Admin user IDs (comma-separated, "local" for local dev)
# SENTINEXT_ADMIN_USER_IDS=local

# Enable destructive endpoints (delete games, clear database)
# SENTINEXT_ENABLE_DESTRUCTIVE=false

# Authentication (leave disabled for self-hosting without Clerk)
# SENTINEXT_AUTH_ENABLED=false
# SENTINEXT_CLERK_JWKS_URL=

# Redis (optional, for job queuing and rate limiting)
# REDIS_URL=redis://localhost:6379

# Sentry error monitoring (optional)
# SENTRY_DSN=
