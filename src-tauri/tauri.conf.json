{
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "python scripts/build_sidecar.py && npm --prefix frontend run build",
    "devPath": "http://localhost:3000",
    "distDir": "../frontend/out"
  },
  "package": {
    "productName": "SentiNext",
    "version": "0.3.8"
  },
  "tauri": {
    "windows": [],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "macOS": {
        "entitlements": "entitlements.plist"
      },
      "identifier": "ai.sentinext.app",
      "icon": [
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "externalBin": ["../backend/dist/sentinext-backend"]
    }
  }
}
